{
  "manifest_version": 3,
  "name": "Myne Clipper",
  "version": "0.4.0",
  "key": "",
  "description": "Keyless web clipper for Myne — clips the page you are reading into your encrypted Myne vault.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Clip this page to Myne",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "commands": {
    "bookmark-page": {
      "description": "Bookmark this page to Myne"
    },
    "pair-myne": {
      "description": "Pair this extension with Myne"
    }
  },
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "scripting",
    "contextMenus",
    "storage"
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; object-src 'none'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "clipper@myne.md",
      "strict_min_version": "121.0"
    }
  }
}
